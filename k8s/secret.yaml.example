# TEMPLATE ONLY — do not put real keys here or commit a filled-in copy.
#
# The real Secret is created out-of-band from the env files already on the box,
# so secrets never touch git:
#
#   kubectl create secret generic tradingagents-secrets -n tradingagents \
#     --from-env-file="$HOME/TradingAgents/.env" \
#     --from-env-file="$HOME/.tradingagents.env"
#
# ($HOME/TradingAgents/.env carries OPENROUTER_API_KEY + vendor keys;
#  $HOME/.tradingagents.env carries FRED_API_KEY + REDDIT_CLIENT_ID/SECRET.)
#
# Note: DD_API_KEY is NOT here — it belongs to the Datadog Agent sidecar
# (installed in Phase 4), not the app. With the sidecar present the app submits
# telemetry through the agent and needs no API key of its own.
#
# The shape kubectl produces:
apiVersion: v1
kind: Secret
metadata:
  name: tradingagents-secrets
  namespace: tradingagents
type: Opaque
stringData:
  OPENROUTER_API_KEY: "<required>"
  ALPHA_VANTAGE_API_KEY: "<optional — fallback vendor>"
  FRED_API_KEY: "<optional — macro data>"
  REDDIT_CLIENT_ID: "<optional — sentiment>"
  REDDIT_CLIENT_SECRET: "<optional — sentiment>"
